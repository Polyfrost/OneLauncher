  "query": "\n\t\tSELECT\n\t\t\tca.hash,\n\t\t\tca.enabled,\n\t\t\tpr.provider as \"provider!: i64\",\n\t\t\tpr.project_id,\n\t\t\tpr.version_id,\n\t\t\tpr.display_name\n\t\tFROM cluster_artifacts ca\n\t\tJOIN provider_releases pr ON pr.hash = ca.hash\n\t\tWHERE ca.cluster_id = ?\n\t\tORDER BY pr.published_at DESC, pr.provider, pr.project_id, pr.version_id\n\t\t",
